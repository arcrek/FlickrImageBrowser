<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/dock_stroke"
    app:strokeWidth="0.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Full-card Photo Thumbnail -->
        <ImageView
            android:id="@+id/image_thumbnail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/content_desc_photo"
            android:minHeight="140dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Floating Scrim Gradient at bottom of image for title overlay -->
        <View
            android:id="@+id/view_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_photo_scrim"
            app:layout_constraintBottom_toBottomOf="@id/image_thumbnail"
            app:layout_constraintEnd_toEndOf="@id/image_thumbnail"
            app:layout_constraintStart_toStartOf="@id/image_thumbnail"
            app:layout_constraintTop_toTopOf="@id/text_photo_title"
            android:layout_marginTop="-24dp" />

        <!-- Top Right Frosted Favorite Pill -->
        <ImageButton
            android:id="@+id/button_item_favorite"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_favorite_pill"
            android:contentDescription="@string/action_toggle_favorite"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_favorite_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Floating Photo Title -->
        <TextView
            android:id="@+id/text_photo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.01"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1.5"
            android:shadowRadius="3"
            android:textColor="@color/text_on_scrim"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/text_photo_owner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Floating Photo Owner (Mint Tinted) -->
        <TextView
            android:id="@+id/text_photo_owner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingBottom="9dp"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/text_on_scrim_secondary"
            android:textSize="10.5sp"
            app:layout_constraintBottom_toBottomOf="@id/image_thumbnail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
