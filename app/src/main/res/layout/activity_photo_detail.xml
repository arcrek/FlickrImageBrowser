<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/image_viewer_background">

    <!-- Top Bar in dark viewer surface -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/image_viewer_background"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/image_viewer_foreground"
        app:title="@string/detail_title"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.Flickr.ToolbarTitle"
        app:titleTextColor="@color/image_viewer_foreground" />

    <!-- Safe Stable Viewing Viewport: constrained strictly between toolbar and metadata so portrait images are never hidden behind chrome -->
    <FrameLayout
        android:id="@+id/image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/image_viewer_background"
        app:layout_constraintBottom_toTopOf="@id/detail_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_detail">

        <vn.edu.usth.flickrimagebrowser.ui.detail.ZoomableImageView
            android:id="@+id/image_detail_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/content_desc_photo" />

        <ProgressBar
            android:id="@+id/progress_detail_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_blue"
            android:visibility="gone" />

        <!-- Error Layout with retry; preserves underlying thumbnail on large image failure -->
        <LinearLayout
            android:id="@+id/layout_image_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC111214"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_broken_image"
                app:tint="@color/image_viewer_foreground" />

            <TextView
                android:id="@+id/text_image_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="@string/detail_error_loading_image"
                android:textAlignment="center"
                android:textColor="@color/viewer_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_retry_image"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/detail_action_retry"
                android:textColor="@color/brand_blue"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/brand_blue" />

        </LinearLayout>

    </FrameLayout>

    <!-- Metadata & ONE Row of Actions below the image, capped at max 240dp so long text/landscape stays bounded -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/image_viewer_background"
        android:clipToPadding="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Author / Owner -->
            <TextView
                android:id="@+id/text_detail_owner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@color/image_viewer_foreground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Title -->
            <TextView
                android:id="@+id/text_detail_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/viewer_secondary"
                android:textSize="13.5sp" />

            <!-- Description (Shown when distinct from title) -->
            <TextView
                android:id="@+id/text_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/viewer_secondary"
                android:textSize="13sp" />

            <!-- ONE Row: Favorite / Add to Album / Share -->
            <LinearLayout
                android:id="@+id/layout_action_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_favorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_favorite_pill"
                    android:contentDescription="@string/detail_action_save_photo"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_favorite_border" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/button_add_to_collection"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_add_to_collection"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_collections"
                    app:tint="@color/image_viewer_foreground" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/button_share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_share"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_share"
                    app:tint="@color/image_viewer_foreground" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
