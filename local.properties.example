## Copy this file to local.properties (or add the PIXABAY_API_KEY line to your existing local.properties)
## Do NOT commit your real local.properties file to version control.

# Path to your local Android SDK (managed automatically by Android Studio)
# sdk.dir=/path/to/Android/Sdk

# Pixabay REST API Key (obtain for free at https://pixabay.com/api/docs/)
# Note: Keys compiled into client APKs via BuildConfig can be extracted from distributed binaries.
PIXABAY_API_KEY=your_pixabay_api_key_here
